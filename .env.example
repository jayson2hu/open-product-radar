# Copy to .env. Never commit credentials.
# demo and production databases are separate and mode checked at open.
RADAR_MODE=demo
PORT=4188
HOST=127.0.0.1
RADAR_PUBLIC_URL=http://127.0.0.1:4188
# Production must use an HTTPS public origin.
# RADAR_ALLOWED_ORIGINS=https://radar.example.com
# RADAR_DB_PATH=data/radar-demo.sqlite
# GitHub OAuth (production; public profile only, no repository scopes).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RADAR_ADMIN_GITHUB_IDS=
# Collection token is independent from user sign-in; unauthenticated public API is supported.
GITHUB_TOKEN=
# Exact allowlisted owner/repo pairs for the explicitly enabled worker.
RADAR_GITHUB_REPOSITORIES=microsoft/playwright,puppeteer/puppeteer
# Per-request timeout, 1000-45000 ms; two requests must fit the 120-second job lease.
RADAR_GITHUB_TIMEOUT_MS=30000
RADAR_DAILY_REQUEST_LIMIT=1000
RADAR_MONTHLY_REQUEST_LIMIT=20000
RADAR_EMAIL_MODE=preview
# Only configure after sender/domain and recipient opt-in verification.
# RADAR_EMAIL_DELIVERY_ENABLED=yes
# RADAR_EMAIL_FROM=updates@your-verified-domain.example
# RADAR_RESEND_API_KEY=
# Collection source must also have approved permission/status in database.
# Real data collection and email sending are never enabled by frontend page requests.
