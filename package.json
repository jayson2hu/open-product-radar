{
  "name": "open-product-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "开源产品雷达：发现、循证比较与持续跟踪",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run build && npm test",
    "worker": "node --env-file-if-exists=.env workers/run.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.63.0",
    "vite": "6.4.3"
  }
}
